{
  "name": "playwright-ts-automation",
  "version": "1.0.0",
  "description": "TypeScript + Playwright UI automation framework demonstrating Page Object Model, API-based authentication, and controlled parallel/serial test execution.",
  "private": true,
  "scripts": {
    "test": "npm run test:parallel && npm run test:serial",
    "test:parallel": "playwright test --grep-invert @serial",
    "test:serial": "playwright test --workers=1 --grep @serial",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JFSoftwareServices/playwright-ts-automation.git"
  },
  "keywords": ["playwright", "typescript", "automation", "e2e", "sdet"],
  "author": "Jide (JFSoftwareServices)",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/JFSoftwareServices/playwright-ts-automation/issues"
  },
  "homepage": "https://github.com/JFSoftwareServices/playwright-ts-automation#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
